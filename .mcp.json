{
  "mcpServers": {
    "coletum": {
      "command": "git",
      "args": [
        "-c",
        "alias.coletum=!sh \"${CLAUDE_PLUGIN_ROOT}/scripts/iniciar.sh\"",
        "coletum"
      ],
      "env": {
        "COLETUM_TOKEN": "${user_config.token}",
        "COLETUM_PASTA": "${user_config.pasta}",
        "COLETUM_DADOS": "${CLAUDE_PLUGIN_DATA}"
      }
    }
  }
}
